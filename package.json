{
  "name": "personal-codex-agent",
  "version": "0.3.0",
  "private": true,
  "main": "dist/desktop/main/index.cjs",
  "description": "Windows-first local desktop agent for prompt alignment and approved Codex implementation runs.",
  "author": "Jamie Kanbier",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:daemon": "tsx apps/daemon/src/index.ts",
    "dev:desktop": "vite --config apps/desktop/vite.config.ts",
    "build": "tsx scripts/build.ts",
    "build:daemon": "tsx scripts/build-daemon.ts",
    "build:desktop": "vite build --config apps/desktop/vite.config.ts && esbuild apps/desktop/src/main/index.ts apps/desktop/src/preload/index.ts --bundle --platform=node --format=cjs --out-extension:.js=.cjs --external:electron --outdir=dist/desktop",
    "build:extension": "esbuild apps/vscode-extension/src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=apps/vscode-extension/dist/extension.cjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:runtime": "vitest run tests/unit/terminal-session.test.ts tests/integration/runtime-supervisor-daemon.test.ts",
    "test:e2e": "vitest run tests/e2e",
    "test:security": "vitest run tests/security",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && npm run package:extension && electron-builder --win nsis portable --x64 --publish never && tsx scripts/verify-package.ts",
    "package:installer": "npm run build && npm run package:extension && electron-builder --win nsis --x64 --publish never && tsx scripts/verify-package.ts",
    "package:portable": "npm run build && npm run package:extension && electron-builder --win portable --x64 --publish never && tsx scripts/verify-package.ts",
    "package:verify": "tsx scripts/verify-package.ts",
    "test:package": "tsx scripts/smoke-packaged.ts",
    "release": "npm run validate",
    "package:extension": "npm run build:extension && tsx scripts/package-extension.ts",
    "electron:install": "node node_modules/electron/install.js",
    "doctor": "tsx scripts/doctor.ts",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run package"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.0",
    "@heyputer/puter.js": "2.6.0",
    "@napi-rs/keyring": "1.3.0",
    "dotenv": "^16.6.1",
    "fastify": "5.11.0",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "@vscode/vsce": "3.9.2",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
