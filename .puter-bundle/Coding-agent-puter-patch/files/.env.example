# Optional daemon port. Omit or set 0 to select an available loopback port.
AGENT_PORT=0
# Optional persistent data root. Defaults to %LOCALAPPDATA%\PersonalCodexAgent.
AGENT_DATA_DIR=
# Optional fixed token for controlled development only. Production generates one.
AGENT_AUTH_TOKEN=
# Repository-writing provider: app-server, puter, or fake.
AGENT_CODEX_PROVIDER=puter
# Codex executable name or absolute path. Used only by the app-server provider.
CODEX_EXECUTABLE=codex
# Puter model used by the repository-writing agent.
PUTER_MODEL=openai/gpt-5.3-codex
# Optional Puter auth token for CI/headless use. Interactive desktop use opens browser login.
PUTER_AUTH_TOKEN=
# Maximum tool-calling iterations per approved run.
PUTER_MAX_AGENT_STEPS=40
# Maximum duration of an individual allowlisted verification command.
PUTER_COMMAND_TIMEOUT_MS=120000
# Commands available to the Puter agent. Subcommands are additionally restricted in code.
PUTER_ALLOWED_COMMANDS=npm,pnpm,yarn,bun,node,git
# Structured log level: trace, debug, info, warn, error.
AGENT_LOG_LEVEL=info
